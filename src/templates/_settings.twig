{% import "_includes/forms" as forms %}

{% set options = {} %}

{% if isCraft5 %}
    {# Craft 5 #}
    {% for section in craft.app.entries.allSections() %}
        {% for entryType in craft.app.entries.getEntryTypesBySectionId(section.id) %}
            {% set name = section.name %}

            {% if section.name != entryType.name %}
                {% set name = name ~ ' (' ~ entryType.name ~ ')' %}
            {% endif %}

            {% set options = options|merge([{ label: name, value: section.id }]) %}
        {% endfor %}
    {% endfor %}
{% else %}
    {# Craft 4 #}
    {% for entryType in craft.app.sections.getAllEntryTypes() %}
        {% set section = entryType.section %}
        {% set name = section.name %}

        {% if section.name != entryType.name %}
            {% set name = name ~ ' (' ~ entryType.name ~ ')' %}
        {% endif %}

        {% set options = options|merge([{ label: name, value: entryType.id }]) %}
    {% endfor %}
{% endif %}

{{ forms.textField({
    label: 'Global query string params',
    instructions: 'Comma-separated list of query string parameters that should bypass caching on all pages.',
    name: 'globalQueryStringParams',
    value: settings.globalQueryStringParams,
    code: true
}) }}

{{ forms.editableTableField({
    label: 'Query string params that should bypass caching and show a non-cached page',
    name: 'sectionQueryStringParams',
    cols: {
        section: {
            type: 'select',
            heading: 'Section',
            options: options
        },
        queryStringParams: {
            type: 'singleline',
            heading: 'Query string params',
            info: 'Comma-separated list of query string parameters to bypass caching, e.g. query,sort',
            code: true,
        },
    },
    rows: settings.sectionQueryStringParams,
    allowAdd: true,
    allowDelete: true
}) }}
