{
    "name": "lameco/craft-blitz",
    "description": "Laméco defaults for Blitz: forced cache settings and per-site query string exclusions",
    "type": "craft-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0",
        "putyourlightson/craft-blitz": "^5.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "lameco\\blitz\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "lameco\\blitz\\tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Laméco",
            "homepage": "https://www.lameco.nl"
        }
    ],
    "extra": {
        "handle": "_craft-blitz",
        "name": "Laméco Blitz",
        "developer": "Laméco",
        "documentationUrl": ""
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "phpstan": "phpstan --memory-limit=1G",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    }
}
